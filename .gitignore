# -------------------------------------------------------------------
.env
.env.*
!.env.example
local_settings.py

# -------------------------------------------------------------------
# 8. 数据库与持久化数据 (Databases & Uploads)
# -------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal
data/*
!data/.gitkeep
backend/data/*
!backend/data/.gitkeep
uploads/*
!uploads/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep

# 8.1 内置静态贴纸与素材 (必须提交 Git，保证全新环境部署正常)
!backend/app/static/images/default_stickers/
!backend/app/static/images/dinosaurs/

# -------------------------------------------------------------------
# 9. 语音与机器学习大模型 (STT Voice Models)
# -------------------------------------------------------------------
stt/models/
*.onnx

