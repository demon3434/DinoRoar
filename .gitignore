# ===================================================================
# DinoRoar Fullstack Monorepo - Git Ignore Specification
# (FastAPI Backend, Vue3 Frontend, Android Client, STT Service)
# ===================================================================

# -------------------------------------------------------------------
# 1. 内部文档、草稿与私有配置 (Docs, Guides & Scratch Files)
# -------------------------------------------------------------------
docs/
/1001
/logo
*.bak
*.bak.*
*.tmp
*.temp
*.log
*.patch
*.diff

# -------------------------------------------------------------------
# 2. 服务器部署、运维工具与私密调试脚本 (Server Deploy & Ops Scripts)
#    严密防范 186/194/阿里云/SFTP/SSH 等服务器信息与凭证被误传至 GitHub
# -------------------------------------------------------------------
# 根目录与任意子目录下涉及部署、运维、同步与服务器专用的脚本
*deploy*
*sftp*
*aliyun*
*check_ssh*
check_*.py
copy_*.py
fix_*.py
sync_*.py
inspect_*.py
restart_*.py
rollback_*.py
upload_*.py
get_docker_*.py
convert_*.py
backup_*.py

# 特定实机服务器标识脚本与配置 (排除 static/fonts/ 字体分包)
*186*
*194*
!backend/app/static/fonts/

# 根目录所有直接存放的临时脚本
/*.py
/*.sh
/*.ps1
/*.bat

# scripts 目录保护：默认忽略所有运维与部署脚本，仅允许客户端打包构建脚本
scripts/*
!scripts/build_apk.bat

# Docker 多环境与服务器私有 Compose 配置 (仅保留基础模板 docker-compose.yml)
docker-compose.*.yml
docker-compose.*.yaml

# 远程日志与容器日志
remote_*.log
dinoroar_container*.log

# -------------------------------------------------------------------
# 3. AI Agent、OpenSpec 与测试缓存 (Agent & Testing Caches)
# -------------------------------------------------------------------
.agent/
.agents/
openspec/
.pytest_cache/
.history/
skills-lock.json
CONTEXT.md

# -------------------------------------------------------------------
# 4. 后端 Python 与虚拟环境 (Python & Virtual Environments)
# -------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
*.egg-info/
dist/
eggs/
parts/
var/
sdist/
develop-eggs/

