# ===================================================================
# DinoRoar Web & Backend - Git Ignore Specification
# ===================================================================

# 1. 个人服务器与敏感账号文档 (Personal Server & Account Info)
docs/server_info.md
docs/compile_env.md
docs/*secret*
docs/*password*

# 2. 开发过程中的记录存档、历史备份与临时数据 (Archive & Temp Data)
docs/*经验总结*
docs/*总结*.md
docs/仙剑粘土人贴纸/
/1001
/logo
*.bak
*.bak.*
*.tmp
*.temp
*.log
*.patch
*.diff

# 3. 开发中的工具脚本与辅助文件 (Development Tools & Utility Scripts)
deploy.py
deploy.ps1
deploy.bat
push_*.sh
push_*.py
test_*.sh
test_*.py
retry_push_*.sh
check_*.py
copy_*.py
fix_*.py
sftp_*.py
convert_*.py
backup_*.py
get_*.py
*.sh
*.ps1
*.bat

# 4. 本地 AI Agent 目录与测试缓存 (Agent, OpenSpec & Test Caches)
.agent/
.agents/
openspec/
.pytest_cache/
.history/

# 5. Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/

# 6. Environment Variables & Secrets
.env
.env.*
!.env.example
local_settings.py

# 7. Local Databases & Persistent Data
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal
data/*
!data/.gitkeep
backend/data/*
!backend/data/.gitkeep
uploads/*
!uploads/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep

# 7.1 Builtin Seed Static Assets (必须提交 Git，保证全新初始化正常)
!backend/app/static/images/default_stickers/
!backend/app/static/images/dinosaurs/

# 8. Machine Learning & Large Models (STT)
stt/models/
*.onnx

# 9. Deployment Packages & Temporary Zip Archives
*.zip
*.tar.gz
*.rar
dinoroar_deploy.zip

# 10. IDE & Editor Configs
.idea/
.vscode/
*.swp
*.swo

# 11. Operating System Files
.DS_Store
Thumbs.db
