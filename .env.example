# ===================================================================
# DinoRoar 环境变量配置示例模板 (.env.example)
# 使用方法：复制本文件为 .env 并根据实际部署宿主机环境修改参数
# ===================================================================

# 1. 容器系统时区配置 (推荐 Asia/Shanghai)
TZ=Asia/Shanghai

# 2. 宿主机对外映射端口
APP_HTTP_PORT=8080
APP_UDP_PORT=8090

# 3. 宿主机数据与文件持久化挂载路径
HOST_DATA_DIR=/opt/docker/dinoroar/data
HOST_UPLOADS_DIR=/opt/docker/dinoroar/uploads
HOST_STT_MODELS_DIR=/opt/docker/dinoroar/stt_models
