# ===================================================================
# DinoRoar 环境变量配置示例模板 (.env.example)
# 使用方法：复制本文件为 .env 并根据实际部署宿主机环境修改参数
# ===================================================================

# 1. 容器系统时区配置 (推荐 Asia/Shanghai)
TZ=Asia/Shanghai

# 2. 宿主机对外映射端口 (Web 页面与 API 单端口统一服务)
APP_HTTP_PORT=8080
WEB_PORT=8080

# 3. 宿主机通告 IP (可选，用于 mDNS 广播向局域网通告宿主机物理 IP，为空时将自动探测)
SERVICE_ADVERTISE_HOST=

# 4. 宿主机数据与文件持久化挂载路径
HOST_DATA_DIR=/opt/docker/dinoroar/data
HOST_UPLOADS_DIR=/opt/docker/dinoroar/uploads
HOST_STT_MODELS_DIR=/opt/docker/dinoroar/stt_models

# 5. Docker 容器日志限制配置
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=3


